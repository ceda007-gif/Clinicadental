# Clave de la API de Gemini (aistudio.google.com/apikey). Sin esto, el
# asistente de chat responde con un aviso en vez de conversar.
GEMINI_API_KEY=

# Modelo a usar por el asistente (opcional).
# GEMINI_MODEL=gemini-2.5-flash

# Token simple que debe enviar el panel de administración para leer/editar
# contenido y citas (Authorization: Bearer <token>). Cambia este valor por
# uno propio.
ADMIN_TOKEN=dev-admin-token

# Puerto del servidor (opcional, por defecto 3001).
# PORT=3001
