# Clave de la API de Gemini (aistudio.google.com/apikey). Sin esto, el
# asistente de chat responde con un aviso en vez de conversar.
GEMINI_API_KEY=

# Modelo preferido del asistente (opcional; por defecto usa gemini-flash-latest
# primero). Si se satura o no está disponible, el bot salta automáticamente a
# gemini-2.5-flash, luego gemini-2.0-flash y por último gemini-2.0-flash-lite
# (cada modelo tiene su propia cuota gratuita independiente).
# GEMINI_MODEL=gemini-flash-latest

# Token simple que debe enviar el panel de administración para leer/editar
# contenido y citas (Authorization: Bearer <token>). Cambia este valor por
# uno propio.
ADMIN_TOKEN=dev-admin-token

# Puerto del servidor (opcional, por defecto 3001).
# PORT=3001

# Cadena de conexión de Postgres (Supabase u otro), para que el contenido y
# las citas sobrevivan a los despliegues. Sin esta variable, el servidor
# guarda todo en server/data/db.json — funciona para desarrollo local, pero
# en Render (free tier) ese archivo se reinicia con los datos de ejemplo en
# cada despliegue porque el disco no es persistente.
# DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
