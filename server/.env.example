# Clave de la API de Anthropic (console.anthropic.com). Sin esto, el asistente
# de chat responde con un aviso en vez de conversar.
ANTHROPIC_API_KEY=

# Modelo a usar por el asistente (opcional).
# ANTHROPIC_MODEL=claude-sonnet-5

# Token simple que debe enviar el panel de administración para leer/editar
# citas (Authorization: Bearer <token>). Cambia este valor por uno propio.
ADMIN_TOKEN=dev-admin-token

# Puerto del servidor (opcional, por defecto 3001).
# PORT=3001
